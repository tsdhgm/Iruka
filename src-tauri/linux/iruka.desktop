[Desktop Entry]
Type=Application
Name={{name}}
Comment={{comment}}
Exec={{exec}}
Icon={{icon}}
Terminal=false
Categories=Network;RemoteAccess;
# The window's Wayland app id is the binary name ("iruka"). The Tauri identifier
# (dev.tosihide.iruka, from "enableGTKAppId") only travels as the GtkApplication id, which
# GNOME tries first as <id>.desktop and then falls back to this StartupWMClass match.
StartupWMClass={{exec}}
