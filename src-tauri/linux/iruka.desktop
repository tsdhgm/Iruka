[Desktop Entry]
Type=Application
Name={{name}}
Comment={{comment}}
Exec={{exec}}
Icon={{icon}}
Terminal=false
Categories=Network;RemoteAccess;
# The Wayland app id is the Tauri identifier (tauri.conf.json "enableGTKAppId"), not the
# binary name, so name it here for the desktop to match the window to this entry.
StartupWMClass=dev.tosihide.iruka
