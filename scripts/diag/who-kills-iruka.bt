// Prints who generates a fatal signal for any process (SIGKILL, SIGTERM, SIGXCPU, SIGSEGV, SIGABRT, SIGBUS).
// code 0 = kill() from user space (sender = the "from" process); code 128 = generated by the kernel itself
// (then "from" is just the task that was running, e.g. the victim's own thread for the RT watchdog).
// The RLIMIT_RTTIME kill of Iruka looks like: sig=9 to ReceiveQueue(pid N) from ReceiveQueue(pid N ...) code=128
tracepoint:signal:signal_generate
/ args->sig == 9 || args->sig == 15 || args->sig == 24 || args->sig == 11 || args->sig == 6 || args->sig == 7 /
{
  printf("%s sig=%d to %s(pid %d) from %s(pid %d tid %d) code=%d result=%d\n",
    strftime("%Y-%m-%d %H:%M:%S", nsecs), args->sig, args->comm, args->pid, comm, pid, tid, args->code, args->result);
}
